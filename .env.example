# Bergag requires no environment variables for core functionality.
# This file exists to document optional build-time settings. Never put real
# credentials or signing keys in .env or any committed file.

# Optional signed update configuration. Both values must be set at compile
# time and pass validation before the app offers an update check. The public
# key is a minisign public key, not a private signing key.
# BERGAG_UPDATE_ENDPOINT=https://updates.example.com/bergag.json
# BERGAG_UPDATE_PUBLIC_KEY=RWQ...

# Third-party discovery search remains planned and is not wired. These names
# are intentionally not read by the app:
# DISCOVERY_SEARCH_API_KEY=
# DISCOVERY_SEARCH_ENDPOINT=

# Optional AI providers are configured at runtime through the UI and stored
# in OS credential storage. Do not place API keys here.
